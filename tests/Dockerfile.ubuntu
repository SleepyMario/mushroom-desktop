ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends gnome-shell dbus-x11 xvfb xwayland python3 gjs procps libgl1-mesa-dri fonts-dejavu-core x11-utils && rm -rf /var/lib/apt/lists/*
RUN useradd -m tester
ENV HOME=/home/tester XDG_RUNTIME_DIR=/tmp/runtime-tester LIBGL_ALWAYS_SOFTWARE=1
USER tester
